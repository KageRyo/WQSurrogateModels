[Unit]
Description=Aggregate the completed Jetson Nano experiment

[Service]
Type=oneshot
WorkingDirectory=%h/research/water-quality
Environment=PYTHONPATH=WQSurrogateModels/src:WQSurrogateModels/scripts
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
ExecCondition=/usr/bin/test -e WQSurrogateModels/results/jetson_nano_20261026/replay-results/runner-complete.json
ExecCondition=/usr/bin/test ! -e WQSurrogateModels/results/jetson_nano_20261026/reports/replay-complete/manifest.json
ExecStart=%h/research/water-quality/.edge-verification/2026-10-26/research-venv/bin/python WQSurrogateModels/scripts/replay_edge_experiments.py finalize --staging WQSurrogateModels/results/jetson_nano_20261026/replay-staging --results WQSurrogateModels/results/jetson_nano_20261026/replay-results --output WQSurrogateModels/results/jetson_nano_20261026/reports/replay-complete --record-parity-failures
TimeoutStartSec=infinity
UMask=0077
